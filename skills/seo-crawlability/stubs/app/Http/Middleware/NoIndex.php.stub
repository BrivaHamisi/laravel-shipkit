<?php

namespace App\Http\Middleware;

use Closure;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\View;
use Symfony\Component\HttpFoundation\Response;

/**
 * Keeps a page out of search results while still letting crawlers follow its links: it shares
 * $robots with views (for the meta tag) and sends the X-Robots-Tag header (which also covers
 * PDFs, JSON and anything without a <head>).
 */
class NoIndex
{
    public const DIRECTIVE = 'noindex, follow';

    public function handle(Request $request, Closure $next): Response
    {
        View::share('robots', self::DIRECTIVE);

        $response = $next($request);
        $response->headers->set('X-Robots-Tag', self::DIRECTIVE);

        return $response;
    }
}
