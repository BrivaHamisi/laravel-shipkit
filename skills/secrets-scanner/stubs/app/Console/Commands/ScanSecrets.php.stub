<?php

namespace App\Console\Commands;

use Illuminate\Console\Command;
use Symfony\Component\Process\Process;

/**
 * Fail if a secret is committed to git, bundled into public JavaScript, or exposed through
 * a VITE_ variable. Run it before every push (see the pre-push-checks skill) and in CI.
 */
class ScanSecrets extends Command
{
    protected $signature = 'app:scan-secrets {paths?* : Files to scan instead of everything git tracks}';

    protected $description = 'Fail if a secret is committed, bundled into public JavaScript, or exposed through a VITE_ variable';

    /**
     * Credential formats, by name. Values that merely point at a secret (env('...'), config('...'),
     * placeholders such as "sk_live_...") don't match. The last capture group is the secret.
     *
     * @var array<string, string>
     */
    private const PATTERNS = [
        'private key' => '/-----BEGIN (?:RSA |EC |DSA |OPENSSH |ENCRYPTED |PGP )?PRIVATE KEY(?: BLOCK)?-----/',
        'Laravel APP_KEY' => '/\bAPP_KEY\s*=\s*["\']?(base64:[A-Za-z0-9+\/]{40,}={0,2})/',
        'Stripe secret key' => '/\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}/',
        'OpenAI API key' => '/\bsk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}/',
        'Anthropic API key' => '/\bsk-ant-[A-Za-z0-9_-]{32,}/',
        'AWS access key' => '/\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/',
        'GitHub token' => '/\b(?:gh[pousr]_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{50,})\b/',
        'Slack token' => '/\bxox[baprs]-[A-Za-z0-9-]{10,}/',
        'Slack webhook' => '/hooks\.slack\.com\/services\/T[A-Z0-9]+\/B[A-Z0-9]+\/[A-Za-z0-9]{20,}/',
        'Google API key' => '/\bAIza[0-9A-Za-z_-]{35}\b/',
        'Google OAuth client secret' => '/\bGOCSPX-[A-Za-z0-9_-]{24,}/',
        'SendGrid API key' => '/\bSG\.[A-Za-z0-9_-]{16,}\.[A-Za-z0-9_-]{16,}/',
        'npm token' => '/\bnpm_[A-Za-z0-9]{36}\b/',
        'password in a connection URL' => '/\b(?:mysql|mariadb|postgres(?:ql)?|mongodb(?:\+srv)?|redis|rediss|amqp):\/\/[^:\s\/@]+:([^@\s$\{]{6,})@/',
        'secret assigned in code' => '/(?i:secret|passkey|password|passwd|api_?key|access_?token|auth_?token|consumer_?key|client_?id|private_?key)["\']?\s*(?:=>|=|:)\s*["\']?(?!env\(|config\()([A-Za-z0-9+\/_\-]{32,}={0,2})["\']?/',
    ];

    /**
     * Public values that look like secrets but aren't, such as a provider's documented sandbox key.
     * Add them here, never to an inline "ignore" comment.
     *
     * @var list<string>
     */
    private const KNOWN_PUBLIC_VALUES = [];

    /**
     * Folders and files that are never scanned: dependencies, lock files, binaries.
     */
    private const SKIP = '#(^|/)(vendor|node_modules|storage)/|\.lock$|package-lock\.json$|pnpm-lock\.yaml$|\.(png|jpe?g|gif|webp|avif|svg|ico|pdf|docx?|xlsx?|zip|gz|mp4|webm|woff2?|ttf|eot|otf)$#i';

    public function handle(): int
    {
        $findings = [
            ...$this->trackedEnvFiles(),
            ...$this->scanFiles($this->filesToScan()),
            ...$this->publicViteSecrets(),
        ];

        if ($findings === []) {
            $this->info('No secrets found.');

            return self::SUCCESS;
        }

        $this->error(count($findings).' possible secret(s) found. Remove them, then rotate any that were ever pushed:');

        foreach ($findings as $finding) {
            $this->line("  {$finding}");
        }

        return self::FAILURE;
    }

    /**
     * @return list<string>
     */
    private function filesToScan(): array
    {
        $paths = (array) $this->argument('paths');

        if ($paths === []) {
            $paths = array_filter(explode("\n", $this->git(['ls-files'])));
            // What the browser downloads: the built JavaScript, which is usually git-ignored.
            $paths = [...$paths, ...(glob(public_path('build/assets/*.js')) ?: [])];
        }

        return array_values(array_filter($paths, fn (string $path) => is_file($path) && ! preg_match(self::SKIP, $path)));
    }

    /**
     * @param  list<string>  $files
     * @return list<string>
     */
    private function scanFiles(array $files): array
    {
        $findings = [];

        foreach ($files as $file) {
            foreach (file($file, FILE_IGNORE_NEW_LINES) ?: [] as $index => $line) {
                foreach (self::PATTERNS as $name => $pattern) {
                    if (preg_match($pattern, $line, $match) && ! $this->isKnownPublic($match)) {
                        $findings[] = sprintf('%s:%d  %s  %s', $this->relative($file), $index + 1, $name, $this->mask(end($match)));
                    }
                }
            }
        }

        return $findings;
    }

    /**
     * .env files hold real credentials and must never be committed; .env.example is the template.
     *
     * @return list<string>
     */
    private function trackedEnvFiles(): array
    {
        if ($this->argument('paths')) {
            return [];
        }

        $tracked = array_filter(
            explode("\n", $this->git(['ls-files'])),
            fn (string $path) => (bool) preg_match('#(^|/)\.env($|\.)#', $path) && ! str_ends_with($path, '.env.example'),
        );

        return array_values(array_map(fn (string $path) => "{$path}  .env file is tracked by git", $tracked));
    }

    /**
     * VITE_ variables are compiled into the public JavaScript, so none may carry a secret.
     *
     * @return list<string>
     */
    private function publicViteSecrets(): array
    {
        $example = base_path('.env.example');

        if ($this->argument('paths') || ! is_file($example)) {
            return [];
        }

        preg_match_all('/^(VITE_[A-Z0-9_]*(?:SECRET|PASSWORD|PASSKEY|PRIVATE|TOKEN|API_KEY)[A-Z0-9_]*)=/m', (string) file_get_contents($example), $matches);

        return array_map(fn (string $name) => "{$name}  VITE_ variables are public; keep secrets server-side", $matches[1]);
    }

    /**
     * @param  array<int, string>  $match
     */
    private function isKnownPublic(array $match): bool
    {
        return collect($match)->contains(fn (string $value) => in_array($value, self::KNOWN_PUBLIC_VALUES, true));
    }

    /**
     * Show just enough to find the value, never the secret itself.
     */
    private function mask(string $value): string
    {
        return strlen($value) <= 8 ? '[hidden]' : substr($value, 0, 4).'...('.strlen($value).' chars)';
    }

    private function relative(string $path): string
    {
        return str_starts_with($path, base_path()) ? ltrim(substr($path, strlen(base_path())), '/') : $path;
    }

    /**
     * @param  list<string>  $arguments
     */
    private function git(array $arguments): string
    {
        $process = new Process(['git', ...$arguments], base_path());
        $process->run();

        return $process->isSuccessful() ? $process->getOutput() : '';
    }
}
