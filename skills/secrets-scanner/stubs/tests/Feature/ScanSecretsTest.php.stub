<?php

use Illuminate\Support\Str;

/*
 * Every fake secret below is generated when the test runs, so this file never contains
 * anything that looks like a real credential (GitHub push protection would block it).
 */

function secretsFixture(string $contents): string
{
    $path = sys_get_temp_dir().'/scan-secrets-'.Str::random(8).'.php';
    file_put_contents($path, $contents);

    return $path;
}

function fakeToken(int $length, string $alphabet = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'): string
{
    return collect(range(1, $length))->map(fn () => $alphabet[random_int(0, strlen($alphabet) - 1)])->implode('');
}

test('the repository contains no secrets', function () {
    $this->artisan('app:scan-secrets')->expectsOutput('No secrets found.')->assertSuccessful();
});

test('secrets written into code are caught and never printed in full', function (Closure $line, string $kind) {
    $contents = $line();
    $path = secretsFixture($contents);

    $this->artisan('app:scan-secrets', ['paths' => [$path]])
        ->expectsOutputToContain($kind)
        ->doesntExpectOutputToContain(substr($contents, -20))
        ->assertFailed();
})->with([
    'API secret in PHP config' => [fn () => "<?php \$config = ['consumer_secret' => '".fakeToken(48)."'];", 'secret assigned in code'],
    'client ID in an env file' => [fn () => 'PAYPAL_CLIENT_ID='.fakeToken(48), 'secret assigned in code'],
    'Laravel APP_KEY' => [fn () => 'APP_KEY=base64:'.base64_encode(random_bytes(32)), 'Laravel APP_KEY'],
    'Stripe live key' => [fn () => "<?php \$key = 'sk_"."live_".fakeToken(32)."';", 'Stripe secret key'],
    'OpenAI key' => [fn () => 'OPENAI_KEY_IN_JS = "sk-'.'proj-'.fakeToken(48).'"', 'OpenAI API key'],
    'Anthropic key' => [fn () => "const key = 'sk-"."ant-".fakeToken(48)."';", 'Anthropic API key'],
    'GitHub token' => [fn () => 'token: gh'.'p_'.fakeToken(36), 'GitHub token'],
    'AWS key' => [fn () => 'aws = AK'.'IA'.fakeToken(16, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'), 'AWS access key'],
    'database password in a URL' => [fn () => 'DATABASE_URL=postgres:/'.'/app:'.fakeToken(20).'@db.internal:5432/app', 'password in a connection URL'],
    // Built from pieces so this file doesn't itself contain a private key header.
    'private key' => [fn () => '-----BEGIN RSA '."PRIVATE KEY-----\n".fakeToken(64), 'private key'],
]);

test('references to secrets and documentation placeholders are not flagged', function () {
    $path = secretsFixture(implode("\n", [
        "<?php 'consumer_secret' => env('MPESA_CONSUMER_SECRET'),",
        "'client_id' => config('services.paypal.client_id'),",
        'STRIPE_KEY=sk_live_...',
        'APP_KEY=',
        'DATABASE_URL=postgres://app:${DB_PASSWORD}@db.internal:5432/app',
        'OPENAI_API_KEY=your-key-here',
    ]));

    $this->artisan('app:scan-secrets', ['paths' => [$path]])->assertSuccessful();
});

test('secret-looking VITE_ variables are reported, because Vite makes them public', function () {
    $example = base_path('.env.example');
    $original = file_get_contents($example);
    file_put_contents($example, $original."\nVITE_STRIPE_SECRET_KEY=\n");

    try {
        $this->artisan('app:scan-secrets')->expectsOutputToContain('VITE_STRIPE_SECRET_KEY')->assertFailed();
    } finally {
        file_put_contents($example, $original);
    }
});
