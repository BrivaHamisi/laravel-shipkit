(10, 1, '2023-05-01 13:00:00', '2023-05-01 10:00:00', '<!-- wp:paragraph -->\n<p>Hello, world. It\'s a comma, a quote \' and\na new line.</p>\n<!-- /wp:paragraph -->', 'Hello &amp; welcome', '', 'publish', 'hello-world', 'post', 'https://old.example.org/?p=10'),
(11, 1, '2022-01-01 09:00:00', '0000-00-00 00:00:00', 'First line\nsecond line\n\n[caption id=\"attachment_5\" align=\"alignnone\"]<img src=\"https://old.example.org/wp-content/uploads/a.jpg\" alt=\"\" /> A caption[/caption]\n\n[contact-form-7 id=\"5\" title=\"Contact\"]', 'Classic post', 'A short summary', 'publish', 'classic-post', 'post', 'https://old.example.org/?p=11'),
(12, 1, '2024-02-01 09:00:00', '0000-00-00 00:00:00', 'Not finished', 'Draft post', '', 'draft', '', 'post', 'https://old.example.org/?p=12'),
