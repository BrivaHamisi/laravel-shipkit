<?php

use App\Http\Controllers\PayPalCheckoutController;
use Illuminate\Support\Facades\Route;

Route::controller(PayPalCheckoutController::class)->name('paypal.')->group(function () {
    Route::post('payments/paypal/orders', 'create')->middleware('throttle:20,1')->name('create');
    Route::post('payments/paypal/orders/{orderId}/capture', 'capture')->middleware('throttle:20,1')->name('capture');
    Route::post('payments/paypal/orders/{orderId}/cancel', 'cancel')->middleware('throttle:20,1')->name('cancel');
});
