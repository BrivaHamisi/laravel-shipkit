<?php

use App\Enums\PaymentStatus;
use App\Models\Payment;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Illuminate\Http\Client\Request;
use Illuminate\Support\Facades\Http;

uses(RefreshDatabase::class);

beforeEach(function () {
    config(['paypal.mode' => 'sandbox', 'paypal.client_id' => 'client', 'paypal.client_secret' => 'secret', 'paypal.currency' => 'USD']);
});

function fakePayPalCapture(string $orderId, string $value, string $status = 'COMPLETED'): void
{
    Http::fake([
        'api-m.sandbox.paypal.com/v1/oauth2/token' => Http::response(['access_token' => 'pp-token', 'expires_in' => 32400]),
        'api-m.sandbox.paypal.com/v2/checkout/orders' => Http::response(['id' => $orderId, 'status' => 'CREATED'], 201),
        "api-m.sandbox.paypal.com/v2/checkout/orders/{$orderId}/capture" => Http::response([
            'id' => $orderId,
            'status' => 'COMPLETED',
            'payer' => ['name' => ['given_name' => 'Tara', 'surname' => 'Rosh'], 'email_address' => 'tara@buyers.test'],
            'purchase_units' => [['payments' => ['captures' => [['id' => 'CAPTURE-1', 'status' => $status, 'amount' => ['currency_code' => 'USD', 'value' => $value]]]]]],
        ], 201),
    ]);
}

test('an order is created on the server at the chosen amount and captured', function () {
    fakePayPalCapture('ORDER-1', '50.00');

    $this->postJson(route('paypal.create'), ['amount' => 50])->assertOk()->assertJson(['id' => 'ORDER-1']);

    Http::assertSent(fn (Request $request) => str_ends_with($request->url(), '/v2/checkout/orders')
        && $request['purchase_units'][0]['amount'] === ['currency_code' => 'USD', 'value' => '50.00']
        && $request->hasHeader('PayPal-Request-Id'));

    $this->postJson(route('paypal.capture', 'ORDER-1'))->assertJson(['status' => 'completed']);

    expect(Payment::sole())
        ->status->toBe(PaymentStatus::Completed)
        ->gateway->toBe('paypal')
        ->transaction_id->toBe('CAPTURE-1')
        ->name->toBe('Tara Rosh')
        ->email->toBe('tara@buyers.test');
});

test('a capture for a different amount is not accepted', function () {
    fakePayPalCapture('ORDER-2', '1.00');
    $payment = Payment::factory()->paypal()->create(['provider_reference' => 'ORDER-2']);

    $this->postJson(route('paypal.capture', 'ORDER-2'))->assertJson(['status' => 'failed']);

    expect($payment->refresh()->status)->toBe(PaymentStatus::Failed);
});

test('a capture PayPal is still reviewing does not count as paid', function () {
    fakePayPalCapture('ORDER-4', '50.00', 'PENDING');
    $payment = Payment::factory()->paypal()->create(['provider_reference' => 'ORDER-4']);

    $this->postJson(route('paypal.capture', 'ORDER-4'))->assertJson(['status' => 'failed']);

    expect($payment->refresh()->status)->toBe(PaymentStatus::Failed);
});

test('capturing twice is harmless', function () {
    fakePayPalCapture('ORDER-5', '50.00');
    Payment::factory()->paypal()->create(['provider_reference' => 'ORDER-5']);

    $this->postJson(route('paypal.capture', 'ORDER-5'))->assertJson(['status' => 'completed']);
    $this->postJson(route('paypal.capture', 'ORDER-5'))->assertJson(['status' => 'completed']);

    Http::assertSentCount(2);
});

test('closing PayPal without paying marks the payment as abandoned', function () {
    $payment = Payment::factory()->paypal()->create(['provider_reference' => 'ORDER-3']);

    $this->postJson(route('paypal.cancel', 'ORDER-3'))->assertOk();

    expect($payment->refresh()->status)->toBe(PaymentStatus::Abandoned);
});

test('unknown orders are not found', function () {
    $this->postJson(route('paypal.capture', 'NOPE'))->assertNotFound();
});

test('amounts are validated', function (mixed $amount) {
    $this->postJson(route('paypal.create'), ['amount' => $amount])->assertJsonValidationErrors('amount');
})->with([0, 0.5, 20000, 'abc', 10.555]);

test('PayPal that is not set up says so instead of failing', function () {
    config(['paypal.client_id' => null]);

    $this->postJson(route('paypal.create'), ['amount' => 50])->assertStatus(503);

    expect(Payment::count())->toBe(0);
});
