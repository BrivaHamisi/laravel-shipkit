<?php

use Illuminate\Support\Facades\Blade;
use Illuminate\Support\Facades\Route;

beforeEach(function () {
    config(['app.name' => 'Grace Foundation', 'share.description' => 'We help women rebuild their lives.', 'share.image' => 'images/share/default.jpg']);

    Route::get('/_share/home', fn () => Blade::render('<x-share-meta />'));
    Route::get('/_share/post', fn () => Blade::render('<x-share-meta :title="$title" :description="$description" :image="$image" type="article" />', [
        'title' => "Grace's story",
        'description' => '<p>'.str_repeat('A long story about hope. ', 20).'</p>',
        'image' => 'https://cdn.example.org/posts/1/share.jpg',
    ]));
});

test('pages without their own details fall back to the site defaults', function () {
    $this->get('/_share/home')
        ->assertSee('<title>Grace Foundation</title>', escape: false)
        ->assertSee('<meta name="description" content="We help women rebuild their lives.">', escape: false)
        ->assertSee('<meta property="og:image" content="'.asset('images/share/default.jpg').'">', escape: false)
        ->assertSee('<meta property="og:image:width" content="1200">', escape: false)
        ->assertSee('<link rel="canonical" href="'.url('/_share/home').'">', escape: false);
});

test('pages set their own title, description, image and type', function () {
    $response = $this->get('/_share/post')
        ->assertSee('<title>Grace&#039;s story | Grace Foundation</title>', escape: false)
        ->assertSee('<meta property="og:type" content="article">', escape: false)
        ->assertSee('<meta property="og:image" content="https://cdn.example.org/posts/1/share.jpg">', escape: false)
        ->assertDontSee('og:image:width', escape: false);

    preg_match('/<meta name="description" content="([^"]*)">/', $response->getContent(), $match);

    expect(mb_strlen(html_entity_decode($match[1])))->toBeLessThanOrEqual(163)
        ->and($match[1])->not->toContain('<p>');
});

test('every URL in the preview tags is absolute', function () {
    preg_match_all('/(?:content|href)="(https?:[^"]+|\/[^"]*)"/', $this->get('/_share/home')->getContent(), $matches);

    expect($matches[1])->not->toBeEmpty()->each->toStartWith('http');
});
